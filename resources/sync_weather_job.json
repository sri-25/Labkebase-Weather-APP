{
  "name": "Weather Intelligence - Scheduled Sync",
  "tasks": [
    {
      "task_key": "sync_weather",
      "spark_python_task": {
        "python_file": "/Workspace/Users/srijan2554@gmail.com/Labkebase-Weather-APP/notebooks/sync_weather_job.py",
        "parameters": ["--limit", "50"]
      },
      "environment_key": "sync_weather_env"
    }
  ],
  "environments": [
    {
      "environment_key": "sync_weather_env",
      "spec": {
        "client": "5",
        "dependencies": [
          "psycopg2-binary",
          "sqlalchemy",
          "requests",
          "sentence-transformers",
          "databricks-sdk"
        ]
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 * * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1
}
